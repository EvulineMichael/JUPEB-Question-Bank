<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - JUPEB Question Bank</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f0f2f5;
            padding: 20px;
        }
        .admin-container { max-width: 700px; margin: 40px auto; }
        .admin-card {
            background: white;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            margin-bottom: 20px;
        }
        .admin-card h2 { margin-bottom: 8px; color: #0d6efd; }
        .admin-card .subtitle { color: #6c757d; margin-bottom: 20px; font-size: 0.9rem; }
        input[type="email"], input[type="password"], textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 1rem;
            margin-bottom: 12px;
            font-family: inherit;
        }
        input:focus, textarea:focus { outline: none; border-color: #0d6efd; }
        button {
            width: 100%;
            padding: 14px;
            background: #0d6efd;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
        }
        button:hover { background: #0b5ed7; }
        button.danger { background: #dc3545; margin-top: 4px; }
        button.danger:hover { background: #c82333; }
        .success-msg {
            background: #d4edda;
            color: #155724;
            padding: 12px;
            border-radius: 8px;
            display: none;
            margin-top: 12px;
        }
        .user-list { margin-top: 20px; }
        .user-item {
            background: #f8f9fa;
            padding: 14px;
            border-radius: 10px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            border: 1px solid #e9ecef;
        }
        .user-email { font-weight: 600; color: #1a1a2e; }
        .user-info { font-size: 0.8rem; color: #6c757d; }
        .user-date { font-size: 0.75rem; color: #adb5bd; }
        .logout-btn {
            background: #6c757d;
            width: auto;
            padding: 6px 14px;
            font-size: 0.8rem;
        }
        #login-section {
            max-width: 400px;
            margin: 80px auto;
            padding: 30px;
            background: white;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }
        #admin-error { color: #dc3545; font-size: 0.9rem; margin-top: 8px; display: none; }
    </style>
</head>
<body>
    <!-- Login / Passcode Section -->
    <div id="login-section">
        <h2>🔐 Admin Access</h2>
        <p style="color:#6c757d;margin-bottom:16px;">Enter the admin passcode</p>
        <input type="password" id="admin-passcode" placeholder="Enter passcode..." style="text-align:center;letter-spacing:4px;">
        <button onclick="verifyAdmin()">Unlock</button>
        <p id="admin-error">Incorrect passcode</p>
    </div>

    <!-- Admin Panel -->
    <div class="admin-container" id="admin-panel" style="display:none;">
        <div class="admin-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                <h2>🔐 Admin Panel</h2>
                <button onclick="logoutAdmin()" class="logout-btn">Sign Out</button>
            </div>
            <p class="subtitle">Add or remove authorized users</p>
            
            <input type="email" id="user-email" placeholder="Student's Gmail address">
            <textarea id="payment-ref" rows="2" placeholder="Payment reference (e.g., Bank transfer - GTB)"></textarea>
            
            <button onclick="authorizeUser()">✅ Authorize User</button>
            <button class="danger" onclick="removeUser()">🗑️ Remove User</button>
            
            <div class="success-msg" id="success-msg"></div>
            
            <div style="display:flex;justify-content:space-between;align-items:center;margin:20px 0 12px;">
                <h3 style="margin:0;">📋 Authorized Users</h3>
                <button onclick="toggleSort()" id="sort-btn" style="width:auto;padding:8px 14px;background:transparent;color:#6c757d;border:1px solid #e9ecef;border-radius:8px;cursor:pointer;font-size:0.85rem;">
                    <span id="sort-icon">↓</span> <span id="sort-label">Newest</span>
                </button>
            </div>
            
            <div class="user-list" id="user-list">
                <p style="color:#6c757d;">Loading...</p>
            </div>
        </div>
    </div>

    <!-- Firebase SDKs (once) -->
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-firestore-compat.js"></script>
    <script src="firebase-config.js"></script>

    <script>
        const ADMIN_PASSCODE = "michael2026";
        const ADMIN_EMAIL = "evulinemichael@gmail.com";
        let sortOrder = 'desc';

        async function verifyAdmin() {
            const code = document.getElementById('admin-passcode').value;
            if (code !== ADMIN_PASSCODE) {
                document.getElementById('admin-error').style.display = 'block';
                return;
            }
            
            // Passcode correct — now sign in with Google as the admin
            const provider = new firebase.auth.GoogleAuthProvider();
            provider.setCustomParameters({ login_hint: ADMIN_EMAIL, prompt: 'select_account' });
            
            try {
                const result = await auth.signInWithPopup(provider);
                if (result.user.email !== ADMIN_EMAIL) {
                    alert('You must sign in with ' + ADMIN_EMAIL);
                    await auth.signOut();
                    return;
                }
                
                // Success
                sessionStorage.setItem('admin_auth', 'true');
                document.getElementById('login-section').style.display = 'none';
                document.getElementById('admin-panel').style.display = 'block';
                loadUsers();
            } catch (error) {
                alert('Sign-in failed: ' + error.message);
            }
        }

        async function logoutAdmin() {
            await auth.signOut();
            sessionStorage.removeItem('admin_auth');
            document.getElementById('login-section').style.display = 'block';
            document.getElementById('admin-panel').style.display = 'none';
        }

        // Check if already signed in and authorized
        auth.onAuthStateChanged((user) => {
            if (user && user.email === ADMIN_EMAIL && sessionStorage.getItem('admin_auth') === 'true') {
                document.getElementById('login-section').style.display = 'none';
                document.getElementById('admin-panel').style.display = 'block';
                loadUsers();
            }
        });

        document.getElementById('admin-passcode').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') verifyAdmin();
        });

        function toggleSort() {
            sortOrder = sortOrder === 'desc' ? 'asc' : 'desc';
            document.getElementById('sort-icon').textContent = sortOrder === 'desc' ? '↓' : '↑';
            document.getElementById('sort-label').textContent = sortOrder === 'desc' ? 'Newest' : 'Oldest';
            loadUsers();
        }

        async function authorizeUser() {
            const email = document.getElementById('user-email').value.trim();
            const paymentRef = document.getElementById('payment-ref').value;
            if (!email) { alert('Please enter an email'); return; }
            try {
                await db.collection("authorized_users").doc(email).set({
                    authorized_by: "Michael",
                    date: new Date().toISOString().split('T')[0],
                    payment_ref: paymentRef,
                    expiry_date: "June 30, 2027",
                    active: true
                });
                showSuccess(`✅ ${email} authorized!`);
                document.getElementById('user-email').value = '';
                document.getElementById('payment-ref').value = '';
                loadUsers();
            } catch (error) { alert('Error: ' + error.message); }
        }

        async function removeUser() {
            const email = document.getElementById('user-email').value.trim();
            if (!email) { alert('Enter email to remove'); return; }
            if (!confirm(`Remove ${email}?`)) return;
            try {
                await db.collection("authorized_users").doc(email).delete();
                showSuccess(`🗑️ ${email} removed`);
                document.getElementById('user-email').value = '';
                loadUsers();
            } catch (error) { alert('Error: ' + error.message); }
        }

        async function removeUserDirect(email) {
            if (!confirm(`Remove ${email}?`)) return;
            try {
                await db.collection("authorized_users").doc(email).delete();
                showSuccess(`🗑️ ${email} removed`);
                loadUsers();
            } catch (error) { alert('Error: ' + error.message); }
        }

        async function loadUsers() {
            const listEl = document.getElementById('user-list');
            try {
                const snapshot = await db.collection("authorized_users").get();
                if (snapshot.empty) {
                    listEl.innerHTML = '<p style="color:#6c757d;">No users yet</p>';
                    return;
                }
                const users = [];
                snapshot.forEach(doc => users.push({ id: doc.id, ...doc.data() }));
                users.sort((a, b) => {
                    const dateA = new Date(a.date);
                    const dateB = new Date(b.date);
                    return sortOrder === 'desc' ? dateB - dateA : dateA - dateB;
                });
                let html = `<p style="color:#6c757d;margin-bottom:8px;">${users.length} user${users.length !== 1 ? 's' : ''}</p>`;
                users.forEach((data, index) => {
                    const formattedDate = data.date.includes('-') 
                        ? new Date(data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
                        : data.date;
                    html += `
                        <div class="user-item">
                            <div>
                                <span style="font-weight:700;color:#0d6efd;margin-right:8px;">#${index + 1}</span>
                                <span class="user-email">${data.id}</span>
                                <div class="user-info">Expires: ${data.expiry_date || 'N/A'} | ${data.payment_ref || 'No ref'}</div>
                                <div class="user-date">Added: ${formattedDate}</div>
                            </div>
                            <button onclick="removeUserDirect('${data.id}')" style="background:#dc3545;color:white;border:none;padding:6px 14px;border-radius:6px;cursor:pointer;font-size:0.8rem;">🗑️ Remove</button>
                        </div>`;
                });
                listEl.innerHTML = html;
            } catch (error) {
                listEl.innerHTML = '<p style="color:#dc3545;">Error loading users: ' + error.message + '</p>';
            }
        }

        function showSuccess(msg) {
            const el = document.getElementById('success-msg');
            el.textContent = msg;
            el.style.display = 'block';
            setTimeout(() => el.style.display = 'none', 4000);
        }
    </script>
</body>
</html>